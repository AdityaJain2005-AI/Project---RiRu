# Copy to .env. The app reads DB_* directly. Prisma CLI reads DATABASE_URL.

DB_HOST=localhost
DB_PORT=5432
DB_USER=riru
DB_PASS=riru
DB_NAME=riru
DATABASE_URL=postgresql://riru:riru@localhost:5432/riru

# true keeps the shared Maya Chen demo. false gives each browser its own guest.
# Zerops production yaml sets this to true until SESSION_SECRET is stored there.
DEMO_MODE=false

# Required in production when DEMO_MODE is not true. At least 16 characters.
SESSION_SECRET=replace-with-a-long-random-string

ML_SERVICE_URL=http://127.0.0.1:8000
ML_SERVICE_TOKEN=replace-with-a-long-random-string

# tesseract reads label photos inside the ML service. paddle is rejected.
# A typed ingredient list does not use this.
OCR_PROVIDER=tesseract
LLM_PROVIDER=rules
OLLAMA_BASE_URL=http://127.0.0.1:11434
XAI_API_KEY=
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# none discards image bytes. supabase stores only after a later phase opts in.
STORAGE_PROVIDER=none
STORAGE_BUCKET=
STORAGE_SIGN_TTL_SECONDS=600
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

SENTRY_DSN=
GUEST_RETENTION_DAYS=30
NODE_ENV=development
