*.tsbuildinfo
.turbo/
build-info.json

# Environment (secrets — never commit)
.env
.env.*
!.env.example

# Debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Testing
coverage/

# Vercel (local CLI metadata)
.vercel/

