{
  "name": "facelab",
  "version": "1.0.0",
  "author": "Facelab",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "workspaces": [
    "packages/shared"
  ],
  "scripts": {
    "build:info": "node scripts/generate-build-info.js",
    "build": "node scripts/generate-build-info.js && next build",
    "dev": "next dev --hostname 0.0.0.0 --port 3000",
    "start": "node .next/standalone/server.js",
    "migrate": "node migrate.js",
    "test": "node --experimental-strip-types --test tests/session-token.test.ts tests/storage.test.ts tests/shared-schema.test.ts tests/image-bytes.test.ts tests/scan-analysis.test.ts tests/ingredients.test.ts tests/recommend.test.ts tests/routine-db.integration.test.ts",
    "typecheck": "tsc --noEmit",
    "prisma:validate": "prisma validate"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^0.511.0",
    "next": "^16.2.11",
    "pg": "^8.13.3",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/pg": "^8.11.11",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "postcss": "^8.5.10",
    "prisma": "6.19.3",
    "tailwindcss": "^3.4.17",
    "typescript": "5.9.3"
  },
  "overrides": {
    "sharp": ">=0.35.0"
  },
  "keywords": [
    "facelab",
    "nextjs",
    "skincare",
    "zerops",
    "ai"
  ]
}
